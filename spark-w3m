#!/bin/sh
# spark-w3m -- `spark read` for a w3m buffer: stderr folded into stdout,
# so the refusal a source earns ("the source does not answer -- it
# opens: ...", or the part count of a long page) shows in w3m's pipe
# buffer instead of vanishing; and long lines wrapped at spaces, because
# w3m shows piped text as it comes. SPARK_W3M_WIDTH sets the wrap
# column (default 78).
#
# --ask is the key's mode (keymap M-s): the spark prompt on the
# terminal while w3m waits, the page still on stdin. Enter or ? alone
# is the overview; words (a leading ?, the editors' habit, stripped)
# are the question, flags like --part 2 ride along; Ctrl-C is never
# mind. The words never glob (set -f) and never touch the page.
# The pulse, on the one row this wrapper may touch (the bottom row,
# absolute addressing, never a newline -- a scroll shifts every later
# w3m repaint one off): the page's size, an ASCII spinner, the
# seconds. w3m shows the answer buffer only when the pipe ends, so the
# spinner runs the whole wait and the row is cleared at the end.
pulse_start() {
    P_T0=$(date +%s)
    ( n=0
      while :; do
          case $((n % 4)) in
              0) f='|' ;; 1) f='/' ;; 2) f='-' ;; 3) f='\' ;;
          esac
          printf '\033[9999;1H\033[2Kspark reads %s characters  %s %ss' \
              "$1" "$f" "$(( $(date +%s) - P_T0 ))" > /dev/tty
          n=$((n + 1))
          sleep 0.25
      done ) 2>/dev/null &
    PULSE=$!
}

pulse_stop() {
    [ -z "${PULSE-}" ] || kill "$PULSE" 2>/dev/null
    PULSE=
    printf '\033[9999;1H\033[2K' > /dev/tty
}

case ${1-} in
    --ask)
        old=$(stty -g < /dev/tty 2>/dev/null || true)
        # Ctrl-C cancels: w3m stops reading its stream on the same
        # SIGINT, so no goodbye line can land in the buffer -- the
        # empty buffer is the cancel, and B goes back. Restore the tty.
        trap '[ -z "${PULSE-}" ] || kill "$PULSE" 2>/dev/null; [ -z "$old" ] || stty "$old" < /dev/tty; exit 130' INT
        # w3m leaves the cursor anywhere (top-left on the console, over
        # the page's first line); put the prompt on the screen's last
        # row -- row 9999 clamps to the bottom -- and clear that row.
        # The keys are read raw and echoed by hand, and Enter is
        # swallowed: a newline echoed on the bottom row scrolls the
        # whole screen, and w3m, not knowing, then repaints every row
        # one off. No byte but the typed characters reaches the tty.
        [ -z "$old" ] || stty -icanon -echo min 1 time 0 < /dev/tty
        printf '\033[9999;1H\033[2Kspark> ' > /dev/tty
        q=
        while :; do
            c=$(dd bs=1 count=1 2>/dev/null < /dev/tty)
            case $c in
                ""|"$(printf '\r')") break ;;
                "$(printf '\003')")
                    printf '\033[2K\033[9999;1H' > /dev/tty
                    [ -z "$old" ] || stty "$old" < /dev/tty
                    exit 130 ;;
                "$(printf '\177')"|"$(printf '\b')")
                    [ -z "$q" ] || { q=${q%?}; printf '\b \b' > /dev/tty; } ;;
                *) q="$q$c"; printf %s "$c" > /dev/tty ;;
            esac
        done
        printf '\033[2K\033[9999;1H' > /dev/tty
        [ -z "$old" ] || stty "$old" < /dev/tty
        case $q in "?"*) q=${q#?} ;; esac
        set -f
        set -- $q
        set +f
        page=$(cat)
        pulse_start "$(printf %s "$page" | wc -c | tr -d ' ')"
        printf '%s\n' "$page" | spark read "$@" 2>&1 | fold -s -w "${SPARK_W3M_WIDTH:-78}"
        pulse_stop
        trap - INT
        exit 0
        ;;
esac
spark read "$@" 2>&1 | fold -s -w "${SPARK_W3M_WIDTH:-78}"
